{
  "name": "isekai-tab",
  "description": "Isekai Tab - Anime wallpaper new tab extension",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "icons": "python3 scripts/patch-icons.py",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@solar-icons/svelte": "^2.3.3"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.3.6",
    "@wxt-dev/module-svelte": "^2.0.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
